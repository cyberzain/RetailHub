# RetailHub Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your local or Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/retailhub

# JWT Secret & Expiry
JWT_SECRET=retailhub_jwt_super_secure_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma separated)
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000,http://localhost:5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Default Admin Seed Settings (Optional)
ADMIN_EMAIL=owner@retailhub.com
ADMIN_PASSWORD=AdminSecurePassword123!
